# 管理面板密码
# 值含空格或特殊字符时使用单引号
PIXIVARCHIVE_ADMIN_PASSWORD=

# Docker媒体目录，必须是已经存在的宿主机绝对路径
# Compose会把此目录挂载到容器内固定的/data/media
PIXIVARCHIVE_MEDIA_HOST_PATH=/srv/pixivarchive/media

# 原生Linux图片存储目录，必须是绝对路径
# PIXIVARCHIVE_MEDIA_ROOT=/srv/pixivarchive/media

# 原生部署的监听地址；Docker部署的宿主机发布地址
PIXIVARCHIVE_WEB_BIND=0.0.0.0:7088

# 日志级别：error、warn、info、debug、trace
RUST_LOG=pixivarchive=info,tower_http=info

# Pixiv需要代理时取消注释
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=127.0.0.1,localhost,postgres

# Docker部署填写，建议使用字母、数字、减号和下划线
# POSTGRES_PASSWORD=

# 原生部署填写
# DATABASE_URL=postgresql://pixivarchive:password@127.0.0.1:5432/pixivarchive
